{
  "name": "meetsummarizer-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder",
    "test": "node --test",
    "benchmark:prepare-ami": "node stt/prepare-ami-benchmark.js",
    "benchmark:whisper": "node stt/benchmark-whisper.cpp.js",
    "validate:vulkan": "node stt/validate-vulkan.js"
  },
  "build": {
    "appId": "com.meetsummarizer.app",
    "productName": "MeetSummarizer",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "stt/backend-catalog.js",
      "stt/backend-installer.js",
      "stt/sidecar-manager.js",
      "stt/stt-preferences.js",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "stt",
        "to": "stt",
        "filter": [
          "whisper-streaming-sidecar.js",
          "bin/cpu/whisper-cli.exe",
          "bin/cpu/whisper.dll",
          "bin/cpu/ggml.dll",
          "bin/cpu/ggml-base.dll",
          "bin/cpu/ggml-cpu-*.dll",
          "bin/vulkan/whisper-cli.exe",
          "bin/vulkan/whisper.dll",
          "bin/vulkan/ggml.dll",
          "bin/vulkan/ggml-base.dll",
          "bin/vulkan/ggml-cpu.dll",
          "bin/vulkan/ggml-vulkan.dll"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "yazl": "^2.5.1"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "koffi": "^3.1.3",
    "yauzl": "^2.10.0"
  }
}
